{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/logout/layout,_N_T_/logout/error/layout,_N_T_/logout/error/page,_N_T_/logout/error"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/logout/error/__PAGE__",
    "/logout/error",
    "/logout",
    "/_index",
    "/_head"
  ]
}